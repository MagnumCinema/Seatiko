# Seatiko — the only environment file. Copy it: cp .env.example .env
# docker compose reads .env and hands every container only what it needs.
# Keys and passwords live in .env only (git-ignored); never commit .env.

# ── Project ──────────────────────────────────────────────────────────────────
APP_ENV=development
# The API behind nginx /api/ (NestJS, ./backend).
SEATIKO_API_UPSTREAM=nest-api:8080
HTTP_PORT=80
BIND_ADDRESS=127.0.0.1
# Signs sign-in tokens. Production: openssl rand -hex 32
JWT_SECRET=dev-seatiko-change-me
# Empty: the browser calls the API on the same origin through nginx.
NEXT_PUBLIC_API_URL=
# Demo sign-in buttons on /login (only with a demo database).
NEXT_PUBLIC_DEMO_LOGIN=false

# ── NestJS API ───────────────────────────────────────────────────────────────
SEATIKO_DB_PASSWORD=seatiko-dev-password
# For running Nest outside Docker (cd backend && npm run start:dev).
DATABASE_URL=postgres://seatiko:seatiko-dev-password@localhost:5433/seatiko
# First administrator, created at start (the site uses real data, no demo accounts).
SEATIKO_ADMIN_EMAIL=
SEATIKO_ADMIN_PASSWORD=
# Cafes and restaurants from OpenStreetMap + Overture, comma separated city slugs.
OPEN_PLACES_CITIES=balti

# ── Files (MinIO / S3) ───────────────────────────────────────────────────────
MINIO_ROOT_USER=seatiko
MINIO_ROOT_PASSWORD=seatiko-minio-dev-secret
S3_BUCKET=seatiko
S3_PUBLIC_URL=/media

# ── Google Maps (optional, needs a billing account) ──────────────────────────
# false = the free OpenFreeMap map; true = the Google map with the keys below.
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=
GOOGLE_PLACES_API_KEY=

# ── AI search (Groq) ─────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Twenty CRM ───────────────────────────────────────────────────────────────
TWENTY_IMAGE_TAG=v2.63.0
SERVER_URL=http://crm.localhost
# API key and webhook secret: Twenty → Settings → APIs & Webhooks.
TWENTY_API_KEY=
TWENTY_WEBHOOK_SECRET=
TWENTY_SYNC_INTERVAL_SECONDS=15
# Twenty's own database, Redis and storage (local development values).
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=3884bf7e5fe04c955220d40d20eb9176
PG_DATABASE_HOST=twenty-db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default
REDIS_URL=redis://twenty-redis:6379
# Local development values. Production: new ones from openssl rand -base64 32
# (keep ENCRYPTION_KEY afterwards: Twenty encrypts data with it).
ENCRYPTION_KEY=oM7R4e2NbrV5TQdwYMySUScNvNqic+ANvMWeB91+z3E=
FALLBACK_ENCRYPTION_KEY=
APP_SECRET=
STORAGE_TYPE=local
LOGIC_FUNCTION_TYPE=LOCAL

# ── NestJS Observe (traces, errors, logs) ────────────────────────────────────
# Written by `cd backend && npx @nestjs/observe link`; move both lines here.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
