# Seatiko application
APP_ENV=development
JWT_SECRET=replace-with-a-long-random-value
# Empty means that the browser uses the same origin through nginx.
NEXT_PUBLIC_API_URL=
HTTP_PORT=80
BIND_ADDRESS=127.0.0.1

# Twenty CRM containers
TWENTY_IMAGE_TAG=v2.57.1
# Pin Twenty image for reproducible deploys; avoid floating `latest` in production.
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=replace-with-a-strong-database-password
PG_DATABASE_HOST=twenty-db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default
REDIS_URL=redis://twenty-redis:6379
SERVER_URL=http://crm.localhost
ENCRYPTION_KEY=replace-with-a-stable-random-encryption-key
FALLBACK_ENCRYPTION_KEY=
APP_SECRET=replace-with-a-long-random-value
STORAGE_TYPE=local
LOGIC_FUNCTION_TYPE=LOCAL
